# Copy to server/.env (server/.env is git-ignored). All values are optional.

# Interface to bind. Keep 127.0.0.1 unless you know why you need otherwise.
# Beyond loopback, set ACCESS_KEY too: anyone who can reach the port can otherwise queue calls.
HOST=127.0.0.1
PORT=8787

# Country assumed for numbers typed without a country code: IN, US, GB or AU.
DEFAULT_COUNTRY=IN

# Shared secret for the web page (optional, 12+ characters). The page asks for it once.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_KEY=

# Extra Host header values to accept (comma separated, no port), e.g. a private
# network name or IP. localhost, 127.0.0.1 and [::1] are always accepted.
ALLOWED_HOSTS=

# Where paired-device hashes and recent calls are stored. Empty = memory only.
DATA_FILE=./data/state.json

# Seconds a queued call waits for the phone before it is marked failed.
COMMAND_TTL_SECONDS=120
