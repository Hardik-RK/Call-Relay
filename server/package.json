{
  "name": "quick-dial-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:web": "tsc -p tsconfig.web.json",
    "start": "npm run build:web && node --env-file-if-exists=.env src/server.ts",
    "test": "npm run build:web && node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
